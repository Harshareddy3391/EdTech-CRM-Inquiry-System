# ==============================================================================
# EdTech CRM & Inquiry System - Environment Configuration Template
# ==============================================================================

# Database Connection (Supabase PostgreSQL)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres:your_supabase_password@db.your_project_ref.supabase.co:5432/postgres"

# Custom JWT Authentication Settings (DO NOT use Supabase Auth)
# Generate a secure 32+ character secret key (e.g. `openssl rand -hex 32`)
SECRET_KEY="supersecretjwtkeyforassessmentevaluationchangethisinproduction"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="1440"

# Server Configuration
BACKEND_HOST="0.0.0.0"
BACKEND_PORT="8000"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Optional Client Environment Keys (for direct frontend Supabase client fallback if used)
VITE_SUPABASE_URL="https://your_project_ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_public_key"
